# Server
PORT=5000
NODE_ENV=development

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://b2b_user:b2b_password@localhost:5432/b2b_marketplace?schema=public"

# JWT — change these to long random strings in production
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-too-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# Client (used by CORS / frontend builds if needed)
CLIENT_URL=http://localhost:3000
